# Supabase — get these from your Supabase project dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Anthropic — get this from console.anthropic.com
# NOTE: In production, move Claude calls to a Supabase Edge Function
# so this key is never exposed in the browser bundle.
VITE_ANTHROPIC_API_KEY=sk-ant-your-key-here
