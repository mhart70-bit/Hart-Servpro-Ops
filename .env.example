# Supabase — get these from your Supabase project dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Anthropic — the key does NOT go here anymore. It lives server-side in the
# parse-note Supabase Edge Function:
#   Production:  supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#   Local dev:   put ANTHROPIC_API_KEY=sk-ant-... in supabase/functions/.env (gitignored)
